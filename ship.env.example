# ship.env — per-app settings for app-shipping-skills.
# Copy to the root of your app project as `ship.env` and fill in your values.
# Plain KEY=value lines only; quote values that contain spaces (bash `source`s this file;
# Python reads it line by line).
# This file must NOT contain secrets. Keys live under ~/.config/app-shipping/;
# ship.env only stores their paths. The values below are placeholders.

# iOS
IOS_BUNDLE_ID=com.example.myapp
IOS_APP_ID=1234567890          # App Store Connect numeric app ID (asc apps list)
IOS_TEAM_ID=ABCDE12345         # Apple Developer Team ID (10 characters)

# Android
ANDROID_PACKAGE=com.example.myapp
PLAY_SERVICE_ACCOUNT_JSON=~/.config/app-shipping/play-service-account.json

# AdMob
ADMOB_PUBLISHER_ID=pub-9876543210987654

# Build (optional). Leave these commented out to use the auto-detected defaults; when no
# default applies, the upload scripts stop and ask for them. Recipes for common toolchains:
# docs/build-recipes.md. Commands run from the project root. Quote values that contain
# spaces; use single quotes so $EXPORT_OPTIONS_PLIST is expanded by the build, not here.
# IOS_BUILD_CMD='your-build-command --export-options "$EXPORT_OPTIONS_PLIST"'   # must produce a release IPA
# IOS_IPA_PATH=build/ios/MyApp.ipa      # IPA the build produces, or a pre-built IPA (then no build runs)
# IOS_CLEAN_CMD='your-clean-command'    # run before the build to clear caches
# ANDROID_BUILD_CMD='./gradlew bundleRelease'                              # must produce a signed release AAB
# ANDROID_AAB_PATH=app/build/outputs/bundle/release/app-release.aab        # AAB the build produces, or a pre-built AAB
# ANDROID_CLEAN_CMD='./gradlew clean'
# VERSION_NAME=1.4.0                    # explicit version, if your project's version source can't be read
# BUILD_NUMBER=12                       # explicit build number / versionCode, same
